# Instalar no contexto http (sites-enabled), após revisar caminhos, domínio e TLS.
# Copiar os snippets media.conf e pwa.conf para /etc/nginx/snippets/conectado/.
map $http_upgrade $conectado_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name conectadoemconcursos.com;
    return 301 https://conectadoemconcursos.com$request_uri;
}

server {
    listen 443 ssl;
    server_name conectadoemconcursos.com;
    ssl_certificate /etc/letsencrypt/live/conectadoemconcursos.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/conectadoemconcursos.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 12m;
    add_header X-Content-Type-Options nosniff always;
    # O marcador deve ser legível pelo nginx e estar fora do código e da mídia.
    if (-f /srv/conectado/maintenance) { return 503; }
    error_page 503 =503 @maintenance;
    location @maintenance {
        default_type text/plain;
        add_header Retry-After 120 always;
        add_header Cache-Control "no-store" always;
        return 503 "Atualização em andamento. Tente novamente em alguns minutos.\n";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
        proxy_cache off;
    }
    location /accounts/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_cache off;
    }
    location /ws/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $conectado_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 75s;
    }
    location ^~ /static/ {
        alias /var/www/conectado-em-concursos/backend/staticfiles/;
        autoindex off;
        limit_except GET HEAD { deny all; }
    }
    include /etc/nginx/snippets/conectado/media.conf;
    include /etc/nginx/snippets/conectado/pwa.conf;
    location ~ /\. { deny all; }
    # /admin e /admin/* pertencem ao Next, não ao admin Django.
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
        proxy_buffering off;
        proxy_cache off;
    }
}
