[Unit]
Description=Publicação de avisos e notícias agendados do Conectado
After=network.target redis-server.service

[Service]
Type=oneshot
User=deploy
Group=www-data
WorkingDirectory=/var/www/conectado-em-concursos/backend
Environment=DJANGO_ENV=production
ExecStart=/var/www/conectado-em-concursos/backend/.venv/bin/python manage.py run_scheduled_routines --routine publish_notifications --routine publish_news
TimeoutStartSec=660
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
