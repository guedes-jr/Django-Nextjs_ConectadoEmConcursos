[Unit]
Description=Backup diário de banco e mídia do Conectado
After=network.target

[Service]
Type=oneshot
User=deploy
Group=www-data
WorkingDirectory=/var/www/conectado-em-concursos/backend
Environment=DJANGO_ENV=production
ExecStart=/var/www/conectado-em-concursos/backend/.venv/bin/python manage.py backup_db
TimeoutStartSec=900
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
