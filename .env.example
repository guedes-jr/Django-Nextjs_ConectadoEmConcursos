# Django
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Google OAuth (exemplo)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# OpenAI Responses API (opcional; sem chave o chat usa assistência local)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_ALLOW_PAID=false
OPENROUTER_TIMEOUT=45
# Legacy provider, used only with AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_TIMEOUT=45

# E-mail (o padrão local imprime mensagens no terminal do Django)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@conectadoemquestoes.local
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false

# Next
# Origem pública usada em redirects no proxy Next em produção
#APP_PUBLIC_URL=https://conectadoemconcursos.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Fontes de concursos e notícias (sincronizadas via `manage.py sync_sources`)
CONCURSOS_SOURCES=pci,google-news
CONCURSOS_HTTP_TIMEOUT=25
CONCURSOS_PCI_URL=https://www.pciconcursos.com.br/concursos/
CONCURSOS_GN_QUERY=concurso público
CONCURSOS_GN_CATEGORY=Destaques
CONCURSOS_GN_LIMIT=25

# Banco de questões — registre somente fontes cuja licença de uso e redistribuição
# tenha sido aprovada. O exemplo usa o dataset sintético de referência (CC0), que vem
# no repositório; para um arquivo licenciado, troque o `path` e o `mapping`.
QUESTIONS_DUPLICATE_THRESHOLD=0.80
QUESTIONS_SUSPICIOUS_THRESHOLD=0.60
QUESTIONS_IMPORT_LIMIT=500
QUESTIONS_SOURCES={"referencia":{"path":"apps/questions/data/reference_dataset.json"}}
#QUESTIONS_SOURCES={"dataset-licenciado":{"path":"/caminho/para/questoes-licenciadas.csv","mapping":{"id":"external_id","question":"statement","answers":"options","answer_index":"correct_answer","board":"banca","subject":"discipline","exam":"exam_title"}}}

# SQLite persistente (sem DB_ENGINE usa SQLite; não aponta para o banco local por padrão no exemplo)
#DB_SQLITE_PATH=/srv/conectado/database/db.sqlite3

# PostgreSQL (opcional; sem DB_ENGINE usa SQLite)
#DB_ENGINE=django.db.backends.postgresql
#DB_NAME=conectado_concursos
#DB_USER=conectado_dev
#DB_PASSWORD=defina-uma-senha-local
#DB_HOST=127.0.0.1
#DB_PORT=5432

# Stripe Checkout (modo de teste por padrão; nunca expor estas chaves ao frontend)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=0
# IDs de Prices recorrentes BRL, com valor e intervalo iguais ao catálogo local.
STRIPE_PRICE_IDS={}

# Persistência (em produção, volumes externos ao diretório de releases)
#MEDIA_ROOT=/srv/conectado/media
MEDIA_URL=/media/
#OFFICIAL_EXAMS_ROOT=/srv/conectado/private/official-exams
#BACKUP_DIR=/srv/conectado/backups
BACKUP_KEEP=20
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
BACKUP_COMMAND_TIMEOUT=600
BACKUP_MAX_FILES=100000
BACKUP_MAX_UNPACKED_BYTES=10737418240
#DB_SSLMODE=verify-full

# Transporte transacional: STARTTLS ou SSL implícito, nunca ambos
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
#EMAIL_SSL_CERTFILE=/caminho/certificado-cliente.pem
#EMAIL_SSL_KEYFILE=/caminho/chave-cliente.pem
