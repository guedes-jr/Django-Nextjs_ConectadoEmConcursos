# Django
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Google OAuth (exemplo)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# OpenAI Responses API (opcional; sem chave o chat usa assistência local)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_TIMEOUT=45

# E-mail (o padrão local imprime mensagens no terminal do Django)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@conectadoemquestoes.local
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false

# Next
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Fontes de concursos e notícias (sincronizadas via `manage.py sync_sources`)
CONCURSOS_SOURCES=pci,google-news
CONCURSOS_HTTP_TIMEOUT=25
CONCURSOS_PCI_URL=https://www.pciconcursos.com.br/concursos/
CONCURSOS_GN_QUERY=concurso público
CONCURSOS_GN_CATEGORY=Destaques
CONCURSOS_GN_LIMIT=25
